ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RISK_TOLERANCE=balanced

# ── Scan side = MAINNET (read-only yield discovery) ──────────────────────────
SCAN_RPC_URL=https://mainnet.sorobanrpc.com
SCAN_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Mainnet Blend V2 pool IDs (Fixed + YieldBlox) — sourced from blend-capital/blend-utils mainnet.contracts.json
SCAN_BLEND_POOL_IDS=CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD,CCCCIQSDILITHMM7PBSLVDT5MISSY7R26MNZXCX4H7J5JQ5FPIYOGYFS
# Circle USDC SAC on Stellar mainnet (issuer GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN)
SCAN_USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# On-chain pool discovery (Blend V2 mainnet). OPTIONAL — these defaults are baked
# into config.ts, so you only need to set them to override (e.g. for testnet).
# Source: blend-capital/blend-utils mainnet.contracts.json (poolFactoryV2 / backstopV2).
# Discovery reads the backstop reward zone (active pools) + factory deploy events,
# and falls back to SCAN_BLEND_POOL_IDS above if on-chain enumeration is empty.
SCAN_POOL_FACTORY_ID=CDSYOAVXFY7SM5S64IZPPPYB4GVGGLMQVFREPSQQEZVIWXX5R23G4QSU
SCAN_BACKSTOP_ID=CAQQR5SWBXKIGZKPBZDH3KM5GQ5GUTPKB7JAFCINLZBC5WXPJKRG3IM7

# ── Exec side = TESTNET (real tx, no real money) ──────────────────────────────
EXEC_RPC_URL=https://soroban-testnet.stellar.org
EXEC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Single testnet Blend V2 pool used for all deposit/rebalance execution
EXEC_POOL_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
# USDC SAC on Stellar testnet
EXEC_USDC_CONTRACT_ID=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
AGENT_SIGNER_SECRET=
SMART_WALLET_ADDRESS=

# ── Guard rails ───────────────────────────────────────────────────────────────
PER_TX_CAP_USDC=2000
DAILY_CAP_USDC=5000
MIN_YIELD_DELTA_BPS=50
REBALANCE_COOLDOWN_SEC=120
SCAN_INTERVAL_SEC=30
