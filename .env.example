ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
RISK_TOLERANCE=balanced

# ── Scan side = MAINNET (read-only yield discovery) ──────────────────────────
SCAN_RPC_URL=https://mainnet.sorobanrpc.com
SCAN_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Mainnet Blend V2 pool IDs (Fixed + YieldBlox) — sourced from blend-capital/blend-utils mainnet.contracts.json
SCAN_BLEND_POOL_IDS=CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD,CCCCIQSDILITHMM7PBSLVDT5MISSY7R26MNZXCX4H7J5JQ5FPIYOGYFS
# Circle USDC SAC on Stellar mainnet (issuer GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN)
SCAN_USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# On-chain pool discovery (Blend V2 mainnet). OPTIONAL — these defaults are baked
# into config.ts, so you only need to set them to override (e.g. for testnet).
# Source: blend-capital/blend-utils mainnet.contracts.json (poolFactoryV2 / backstopV2).
# Discovery reads the backstop reward zone (active pools) + factory deploy events,
# and falls back to SCAN_BLEND_POOL_IDS above if on-chain enumeration is empty.
SCAN_POOL_FACTORY_ID=CDSYOAVXFY7SM5S64IZPPPYB4GVGGLMQVFREPSQQEZVIWXX5R23G4QSU
SCAN_BACKSTOP_ID=CAQQR5SWBXKIGZKPBZDH3KM5GQ5GUTPKB7JAFCINLZBC5WXPJKRG3IM7

# ── Exec side = TESTNET (real tx, no real money) ──────────────────────────────
EXEC_RPC_URL=https://soroban-testnet.stellar.org
EXEC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Our OWN deployed Blend V2 testnet pool (accepts mintable USDC) — proven via
# deploy-blend-pool.ts + deploy-verify-supply.ts. Defaults baked into config.ts.
EXEC_POOL_ID=CBI7WAUQ4NPQFZW4C3MDSVFAZJWV3RCLZSTTMA5OZ6BTPEQMOZZNSZ3Z
# USDC SAC of our deployed pool (issuer = owner, mintable on testnet)
EXEC_USDC_CONTRACT_ID=CD2R7WREEPGIAXZL4ASB76Y6PWTY6ZZXZ6C64AIKFDIG36YKQPNY6B2I
# Backend agent key — the ONE restricted policy signer on EVERY user's smart account.
AGENT_SIGNER_SECRET=
# Legacy single-wallet exec target (keypair mode) / default reference SA address.
# Per-user execution reads each user's smart wallet from the registry instead.
SMART_WALLET_ADDRESS=

# ── Smart account (ARMA-style per-user) ───────────────────────────────────────
# OZ SmartAccount ids proven on testnet — defaults baked into config.ts, so you
# only set these to override.
ED25519_VERIFIER_ID=CBHJOANTAHF2ZKU5HZRZTWP4GX7YCSNR3V3AIMAH5P5R7S465SK24RSO
SPENDING_POLICY_ID=CBLNG63CIFKLFY6ZTL32NWMGPN7NBDSXZUSCQNTLMYRTLIZYA7MG3KAP
# "smart-account" = route execution through per-user OZ smart accounts (the agent
# is a restricted policy signer, ARMA model); "keypair" = legacy single agent-key
# signer. Default: smart-account.
WALLET_MODE=smart-account

# ── Guard rails ───────────────────────────────────────────────────────────────
PER_TX_CAP_USDC=2000
DAILY_CAP_USDC=5000
MIN_YIELD_DELTA_BPS=50
REBALANCE_COOLDOWN_SEC=120
SCAN_INTERVAL_SEC=30

# DeFindex (mainnet, scan-only) — optional. JSON array; empty/omitted = disabled.
# APY/utilization/oracle come LIVE from the underlying Blend pool (blendPoolId).
# TVL uses fallbackTvlUsdc (whole USDC): the strategy contract exposes no no-arg
# total getter (confirmed via scripts/verify-defindex-strategy.ts). NOTE: a value of
# 0 makes the row maximally TVL-penalized and ineligible under "conservative"
# tolerance — set the strategy's real nominal TVL (whole USDC) to surface it.
SCAN_DEFINDEX_STRATEGIES=[{"strategyId":"CDB2WMKQQNVZMEBY7Q7GZ5C7E7IAFSNMZ7GGVD6WKTCEWK7XOIAVZSAP","blendPoolId":"CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD","name":"DeFindex USDC · Blend Fixed","fallbackTvlUsdc":0}]
